{
  "name": "biome-plugin-suitescript example",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "26" }
  },
  "postCreateCommand": "npm ci && npm run lint || true",
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome"],
      "settings": { "editor.defaultFormatter": "biomejs.biome" }
    },
    "codespaces": { "openFiles": ["README.md"] }
  }
}
